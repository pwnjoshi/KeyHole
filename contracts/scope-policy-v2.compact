import CompactStandardLibrary;

export ledger last_policy_commitment: Bytes<32>;
export ledger last_response_commitment: Bytes<32>;
export ledger last_upstream_hash: Bytes<32>;
export ledger compliance_verified: Boolean;
export ledger verification_counter: Counter;

// Keyhole Zero-Knowledge Scope Policy Compliance Circuit v2
// Proves field allowlist membership AND record count / recency bounds

export circuit verify_scope_compliance_v2(
    policy_id: Bytes<32>,
    policy_commitment: Bytes<32>,
    response_commitment: Bytes<32>,
    raw_upstream_payload_hash: Bytes<32>,
    allowed_field_mask: Uint<32>,
    response_field_mask: Uint<32>,
    max_records: Uint<32>,
    actual_records: Uint<32>,
    min_allowed_timestamp: Uint<64>,
    oldest_record_timestamp: Uint<64>
): [] {
    // 1. Field allowlist constraint
    assert(response_field_mask <= allowed_field_mask, "Keyhole ZK Error: Response bitmask exceeds policy allowlist bitmask");

    // 2. Count bound constraint
    assert(actual_records <= max_records, "Keyhole ZK Error: Record count exceeds policy limit");

    // 3. Recency bound constraint
    assert(oldest_record_timestamp >= min_allowed_timestamp, "Keyhole ZK Error: Response contains records outside recency window");

    // 4. Disclosures & Ledger State
    last_policy_commitment = disclose(policy_commitment);
    last_response_commitment = disclose(response_commitment);
    last_upstream_hash = disclose(raw_upstream_payload_hash);
    compliance_verified = true;
    verification_counter.increment(1);
}
